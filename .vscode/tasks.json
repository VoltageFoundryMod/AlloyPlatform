{
  // Every task goes through the root Makefile rather than calling pio/make/npm
  // directly, because on Windows that Makefile is what locates the toolchain:
  // it finds pio.exe under ~/.platformio and switches SHELL and PATH to msys2
  // for the Rack plugin build. Calling the tools straight from PowerShell —
  // which has neither g++ nor jq on PATH — fails. Chocolatey's make on PATH is
  // fine here; the Makefile handles it.
  //
  // Two things are asymmetric between the targets, and the task names reflect
  // it rather than hiding it:
  //
  //   Firmware — ONE IMAGE PER MODULE. The engines cannot be co-resident in
  //              520 KB, so each module is its own PlatformIO env, selected
  //              with MODULE=<module>. Hence "AlloyFlux:" and "Alloy Coil:" tasks.
  //
  //   VCV      — ONE PLUGIN, ALL MODULES. plugin.dll carries every module and
  //              Rack offers them all in the browser, so there is nothing
  //              per-module to build. Hence a single "VCV:" group.
  //
  //   Web      — one build per module, selected with MODULE=<module>, because
  //              the configurator picks its parameter map and SysEx signature
  //              at build time (see web-configurator/src/lib/activeModule.ts).
  //
  // `make help` lists every target.
  "version": "2.0.0",
  "tasks": [
    // ── AlloyFlux firmware ───────────────────────────────────────────────────
    {
      "label": "AlloyFlux: Build firmware",
      "detail": "make firmware — .pio/build/alloyflux/firmware.uf2",
      "type": "shell",
      "command": "make",
      "args": ["firmware"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "AlloyFlux: Upload",
      "detail": "make upload — builds, then flashes over USB",
      "type": "shell",
      "command": "make",
      "args": ["upload"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "AlloyFlux: Upload and monitor",
      "detail": "make upload-monitor — flashes, then opens the serial console",
      "type": "shell",
      "command": "make",
      "args": ["upload-monitor"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },

    // ── Alloy Coil firmware ───────────────────────────────────────────────────
    // Note the clock: this env runs the RP2350 at 192 MHz, not the stock 150.
    // The engine needs ~690 us per block against a 666 us budget at 150, and
    // 192 is the next step that keeps the I2S divider exact. See platformio.ini.
    {
      "label": "Alloy Coil: Build firmware",
      "detail": "make firmware MODULE=alloycoil — .pio/build/alloycoil/firmware.uf2 (192 MHz)",
      "type": "shell",
      "command": "make",
      "args": ["firmware", "MODULE=alloycoil"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Alloy Coil: Upload",
      "detail": "make upload MODULE=alloycoil — builds, then flashes over USB",
      "type": "shell",
      "command": "make",
      "args": ["upload", "MODULE=alloycoil"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Alloy Coil: Upload and monitor",
      "detail": "make upload-monitor MODULE=alloycoil — flashes, then opens the serial console",
      "type": "shell",
      "command": "make",
      "args": ["upload-monitor", "MODULE=alloycoil"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Alloy Coil: Host-build engine",
      "detail": "make coil-host — compiles the engine against nothing but the vendored DaisySP, runs it 10 s at unity feedback, prints its static footprint",
      "type": "shell",
      "command": "make",
      "args": ["coil-host"],
      "group": "test",
      "problemMatcher": ["$gcc"]
    },

    // ── Firmware, both modules ───────────────────────────────────────────────
    {
      "label": "Firmware: Build all modules",
      "detail": "make firmware-all — every module's image in turn. Run this after touching platform/, since it compiles differently against each module.",
      "type": "shell",
      "command": "make",
      "args": ["firmware-all"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Firmware: Serial monitor",
      "detail": "make monitor — 115200 baud. Add MODULE=alloycoil if that is what is flashed; the port is the same either way.",
      "type": "shell",
      "command": "make",
      "args": ["monitor"],
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Firmware: Clean",
      "detail": "make firmware-clean — clears the PlatformIO build for ENV",
      "type": "shell",
      "command": "make",
      "args": ["firmware-clean"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Firmware: Native tests",
      "detail": "make test — PlatformIO test runner (no suites under test/ yet)",
      "type": "shell",
      "command": "make",
      "args": ["test"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },

    // ── Panels ───────────────────────────────────────────────────────────────
    // Rack renders <path> only, so Inkscape text has to be converted. Edit
    // res/<Name>_src.svg and let the build produce res/<Name>.svg; the "vcv"
    // tasks already depend on this, so it normally runs on its own.
    {
      "label": "Panels: Convert edited panels",
      "detail": "make panels — strips the 'components' guide layer, converts text to paths, exports plain SVG. Only touches panels whose _src is newer.",
      "type": "shell",
      "command": "make",
      "args": ["panels"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Panels: Rebuild all (force)",
      "detail": "make panels-force — for when Inkscape's output changed under you rather than the source",
      "type": "shell",
      "command": "make",
      "args": ["panels-force"],
      "group": "build",
      "problemMatcher": []
    },

    // ── VCV Rack plugin — one plugin, both modules ────────────────────────────
    {
      "label": "VCV: Build plugin (both modules)",
      "detail": "make vcv — one vcv-plugin/plugin.dll containing AlloyFlux and Alloy Coil. There is no per-module VCV build.",
      "type": "shell",
      "command": "make",
      "args": ["vcv"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "VCV: Build and install plugin",
      "detail": "make vcv-install — installs into Rack's user plugin directory. Restart Rack to pick it up; both modules appear in the browser.",
      "type": "shell",
      "command": "make",
      "args": ["vcv-install"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "VCV: Package plugin",
      "detail": "make vcv-dist — builds the .vcvplugin for the VCV library",
      "type": "shell",
      "command": "make",
      "args": ["vcv-dist"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "VCV: Clean plugin",
      "detail": "make vcv-clean",
      "type": "shell",
      "command": "make",
      "args": ["vcv-clean"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "VCV: Print Rack plugin directory",
      "detail": "make print-plugins-dir — where 'VCV: Build and install' puts the plugin",
      "type": "shell",
      "command": "make",
      "args": ["print-plugins-dir"],
      "problemMatcher": []
    },

    // ── Alloy Controller — one build, every module ────────────────────────────
    // There is nothing per-module to build here: the page reads the SysEx
    // signature off the port and loads that module's parameter map. These used
    // to be four tasks — a build and a dev server per module, plus a build-all —
    // back when VITE_MODULE baked the choice in at build time.
    {
      "label": "Web: Build",
      "detail": "make web — production build into web-configurator/dist",
      "type": "shell",
      "command": "make",
      "args": ["web"],
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      // Chrome or Edge only — Web Serial and Web MIDI are not in Firefox/Safari.
      "label": "Web: Dev server",
      "detail": "make web-dev — vite on localhost:5173",
      "type": "shell",
      "command": "make",
      "args": ["web-dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+),(\\d+)\\):\\s+(error|warning)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*ready in.*"
        }
      }
    },
    {
      "label": "Web: Type check",
      "detail": "make web-check — svelte-check + tsc",
      "type": "shell",
      "command": "make",
      "args": ["web-check"],
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Web: Install dependencies",
      "detail": "make web-deps — npm install",
      "type": "shell",
      "command": "make",
      "args": ["web-deps"],
      "problemMatcher": []
    },

    // ── Parameters ───────────────────────────────────────────────────────────
    // A module declares its parameters once in modules/<name>/params.json; this
    // regenerates the C++ table and the web map from it. Commit the output — an
    // ordinary build never needs Python.
    {
      "label": "Params: Regenerate (AlloyFlux)",
      "detail": "make params — param_manifest.generated.h + paramMapAlloyFlux.ts",
      "type": "shell",
      "command": "make",
      "args": ["params"],
      "problemMatcher": []
    },
    {
      "label": "Params: Regenerate (Alloy Coil)",
      "detail": "make params MODULE=alloycoil — param_manifest.generated.h + paramMapAlloyCoil.ts",
      "type": "shell",
      "command": "make",
      "args": ["params", "MODULE=alloycoil"],
      "problemMatcher": []
    },
    {
      "label": "Params: Check up to date",
      "detail": "make params-check — CI gate; fails if the committed tables are stale. Also fires on a dirty working tree, which is expected.",
      "type": "shell",
      "command": "make",
      "args": ["params-check"],
      "group": "test",
      "problemMatcher": []
    },

    // ── Across the repo ──────────────────────────────────────────────────────
    {
      "label": "Build everything",
      "detail": "make everything — every firmware image + the VCV plugin + every web build. Run this after any change under platform/.",
      "type": "shell",
      "command": "make",
      "args": ["everything"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Format C/C++ (all tracked)",
      "detail": "make format — clang-format -i per .clang-format. Vendored trees (vendor/, modules/alloycoil/) are excluded on purpose.",
      "type": "shell",
      "command": "make",
      "args": ["format"],
      "problemMatcher": []
    },
    {
      "label": "Check C/C++ format (dry-run)",
      "detail": "make format-check — fails if anything is misformatted",
      "type": "shell",
      "command": "make",
      "args": ["format-check"],
      "problemMatcher": []
    }
  ]
}
